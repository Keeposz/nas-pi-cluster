{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Brussels",
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "kubernetes": {
    "managerFilePatterns": ["/^deployments/.+/templates/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Skip floating :latest tags (we want to stay on latest by restarting pods)",
      "matchManagers": [
        "kubernetes"
      ],
      "matchCurrentValue": "/^latest$/",
      "enabled": false
    },
    {
      "description": "Group all Helm chart updates per app into a single PR",
      "matchManagers": [
        "helmv3"
      ],
      "groupName": "{{depName}} chart"
    },
    {
      "description": "everything except majors merges without a click, majors stay a pr for review (no ci checks in this repo)",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "ignoreTests": true
    }
  ]
}
