{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Brussels",
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "separateMajorMinor": false,
  "kubernetes": {
    "managerFilePatterns": ["/^deployments/.+/templates/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Skip floating :latest tags (we want to stay on latest by restarting pods)",
      "matchManagers": [
        "kubernetes"
      ],
      "matchCurrentValue": "/^latest$/",
      "enabled": false
    },
    {
      "description": "one pr per app with all its chart and image bumps (majors included), named after the app folder",
      "matchFileNames": ["deployments/**"],
      "groupName": "{{{replace '^deployments/[^/]+/([^/]+)/.*$' '$1' packageFile}}}"
    },
    {
      "description": "all github actions bumps in one pr",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
